<?xml version="1.0" encoding="UTF-8"?>
  <templates>
        <t t-name="api_mitienda_peru.TarjetaSincronizacion">
        <ControlPanel/>
            <div class="o_tablero_dashboard">
                <div t-att-class="'o_kanban_record o_kanban_dashboard o_color_' + state.color">
                    <!--Cabecera-->
                    <div class="o_kanban_card_header d-flex justify-content-between align-items-center">
                        <div class="o_kanban_card_header_title">
                            <span class="fs-4 fw-bold">Sincronización de Ventas</span>
                        </div>
                        <div class="o_kanban_manage_button_section">
                            <a class="o_kanban_manage_toggle_button px-2" t-on-click="toggleMenu">
                                <i class="fa fa-ellipsis-v"/>
                            </a>
                        </div>
                    </div>
                    <div t-if="state.menuAbierto" class="o_kanban_card_manage_section">
                        <div class="container">
                            <!-- <div class="row o_kanban_card_manage_settings">
                                <div class="col-6">
                                    <a t-on-click="toggleFavorite" style="cursor:pointer;">
                                        <i t-att-class="state.isFavorite ? 'fa fa-star o_dashboard_star' : 'fa fa-star-o o_dashboard_star'"/>
                                        <span class="ms-1">Favorito</span>
                                    </a>
                                </div>
                                <div class="col-6 text-end">
                                    <a t-on-click="verMas" style="cursor:pointer;">
                                        Ver listado
                                    </a>
                                </div>                            
                            </div> -->
                            <div class="row o_kanban_card_manage_settings mt-2">
                                <div class="col-12">
                                    <ul class="o_colorlist d-flex flex-wrap gap-1 list-unstyled mb-0">
                                        <t t-foreach="colors" t-as="c" t-key="c">
                                            <li t-att-class="'o_colorlist_item_color_' + c" t-on-click="() => this.setColor(c)" style="width:18px; height:18px; cursor:pointer; border-radius:50%;"/>
                                        </t>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="mt-3 p-0 container-fluid">
                        <div class="row mb-2">
                            <div class="col mb-3 mb-sm-0">
                                <button class="btn btn-primary btn-sm" t-on-click="verMas">
                                    Ver más
                                </button>
                            </div>
                            <div class="col-auto" t-if="state.sincronizaciones.length > 0">
                                <t t-foreach="state.sincronizaciones" t-as="sinc" t-key="sinc.id">
                                    <div class="row">
                                        <div class="col overflow-hidden text-start">
                                            <a t-on-click="() => this.verVenta(sinc.sale_order_id)" style="cursor:pointer;">
                                                <t t-esc="sinc.sale_order_name"/>
                                            </a>
                                        </div>
                                        <div class="col-auto text-end text-muted small">
                                            <t t-esc="sinc.fecha"/>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                        <div class="row mt-auto">
                            <div class="o_dashboard_graph">
                                <canvas t-ref="chart"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
</templates>