<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_tablero_kanban" model="ir.ui.view">
        <field name="name">tablero.kanban</field>  
        <field name="model">mitienda.pe.tablero</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="sincronizaciones_count"/>
                <field name="ultimas_sincronizaciones_html"/>
                <field name="grafico_data"/>
                <field name="is_favorite"/>
                <field name="color"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="o_kanban_record o_tablero_dashboard o_color_#{record.color.raw_value}">
                            <div class="o_kanban_card_header d-flex justify-content-between align-items-center">
                                <div class="o_kanban_card_header_title">
                                    <span class="fs-4 fw-bold">Sincronización de Ventas</span>
                                </div>
                                <div class="o_kanban_manage_button_section">
                                    <a class="dropdown-toggle o-no-caret btn" data-bs-toggle="dropdown" href="#" role="button">
                                        <i class="fa fa-ellipsis-v"/>
                                    </a>
                                    <div class="dropdown-menu" role="menu">
                                        <ul class="oe_kanban_colorpicker" data-field="color"/>
                                        <a class="o_siat_favorite_toggle dropdown-item" type="object" name="action_toggle_favorite" href="#">
                                            <i t-attf-class="fa #{record.is_favorite.raw_value ? 'fa-star' : 'fa-star-o'}"/>
                                            <span t-esc="record.is_favorite.raw_value ? 'Quitar de favoritos' : 'Marcar como favorito'"/>
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <div class="mt-3 p-0 container-fluid">
                                <div class="row mb-2">
                                    <div class="col mb-3 mb-sm-0">
                                        <button type="object" name="action_ver_mas" class="btn btn-primary btn-sm">
                                            Ver más
                                        </button>
                                    </div>
                                </div>
                                <!-- <div>DEBUG sincronizaciones_count: <t t-esc="record.sincronizaciones_count.raw_value"/></div> -->
                                <div class="col-auto" t-if="record.sincronizaciones_count.raw_value > 0">
                                    <field name="ultimas_sincronizaciones_html" widget="html"/>
                                </div>
                                <div class="row mt-auto">
                                    <div class="o_dashboard_graph">
                                        <canvas t-att-data-chart="record.grafico_data.raw_value" class="o_mitienda_sync_chart"/>
                                    </div>
                                </div>                          
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
  