<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_tablero_kanban" model="ir.ui.view">
        <field name="name">mitienda.tablero.kanban</field>
        <field name="model">mitienda.pe.tablero</field>
        <field name="arch" type="xml">
            <kanban
                create="false"
                delete="false"
                quick_create="false"
                group_create="false"
                records_draggable="false"
                class="o_kanban_dashboard mitienda_tablero"
            >
                <field name="name"/>
                <field name="sincronizaciones_count"/>
                <field name="ultimas_sincronizaciones_html"/>
                <field name="grafico_data"/>
                <field name="is_favorite"/>
                <field name="color"/>

                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="o_kanban_record o_kanban_color_#{record.color.raw_value}">
                            <div class="o_kanban_card_header d-flex justify-content-between align-items-start">
                                <div class="o_kanban_card_header_title">
                                    <h4 class="mb-0 fw-bold">
                                        <field name="name" />
                                    </h4>
                                </div>
                                <div class="dropdown">
                                    <a
                                        class="btn btn-link p-0 text-body dropdown-toggle o-no-caret"
                                        data-bs-toggle="dropdown"
                                        href="#"
                                        role="button"
                                    >
                                        <i class="fa fa-ellipsis-v"/>
                                    </a>
                                    <div class="dropdown-menu dropdown-menu-end">
                                        <ul class="oe_kanban_colorpicker" data-field="color"/>
                                        <a class="dropdown-item" type="object" name="action_toggle_favorite" href="#">
                                            <i t-att-class="record.is_favorite.raw_value ? 'fa fa-star' : 'fa fa-star-o'"/>
                                            <span class="ms-2">
                                                <t t-if="record.is_favorite.raw_value">Quitar de favoritos</t>
                                                <t t-else="">Marcar como favorito</t>
                                            </span>
                                        </a>
                                        <!-- <a role="menuitem" type="delete" class="dropdown-item">Remover</a> -->
                                    </div>
                                </div>
                            </div>

                            <div class="o_kanban_card_content d-flex flex-column gap-3">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <button type="object" name="action_ver_mas" class="btn btn-primary">
                                            Ver más
                                        </button>
                                    </div>
                                    <div t-if="record.sincronizaciones_count.raw_value">
                                        <field name="ultimas_sincronizaciones_html" widget="html"/>
                                    </div>
                                </div>
                                <div class="o_dashboard_graph mt-auto">
                                    <canvas t-att-data-chart="record.grafico_data.raw_value" class="o_mitienda_sync_chart"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
