<data noupdate="0">
    <record id="dte_sincronizar_venta_mitienda_pe" model="ir.cron">
        <field name="name">Sincronizar ventas API MiTienda.pe</field>
        <field name="model_id" ref="model_wizard_mitienda_pe_ventas" />
        <field name="state">code</field>
        <field name="user_id" ref="base.user_root" />
        <field name="code">model.cron_sincronizar_venta()</field>
        <field name="active" eval="True" />
        <field name="interval_number">4</field>
        <field name="interval_type">hours</field>
        <field name="priority">0</field>
        <field name="nextcall"
            eval="(DateTime.now() + timedelta(minutes=5)).strftime('%Y-%m-%d %H:%M:%S')" />
    </record>
</data>