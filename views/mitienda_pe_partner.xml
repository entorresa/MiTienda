<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="dte_view_form_mitienda_partner" model="ir.ui.view">
            <field name="name">dte_view_form_mitienda_partner</field>
            <field name="model">mitienda.pe.partner</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group string="Sincronización">
                                <field name="fecha_sincronizacion" />
                                <field name="conexion_id" />
                                <field name="company_id" invisible="1"/>
                            </group>
                            <group string="Clientes">
                                <field name="partner_id" />
                                <field name="mitienda_name" />
                                <field name="mitienda_last_name" />
                                <field name="mitienda_email" />
                                <field name="mitienda_doc_number" />
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="dte_view_list_mitienda_partner" model="ir.ui.view">
            <field name="name">dte_view_list_mitienda_partner</field>
            <field name="model">mitienda.pe.partner</field>
            <field name="arch" type="xml">
                <list string="clientes sincronizados" edit="False">
                    <field name="fecha_sincronizacion" />
                    <field name="conexion_id" />
                    <field name="partner_id" />
                    <field name="mitienda_name" />
                    <field name="mitienda_last_name" />
                    <field name="mitienda_email" />
                    <field name="mitienda_doc_number" />
                    <field name="company_id" optional="hide"/>
                </list>
            </field>
        </record>

        <record id='action_mi_tienda_pe_partner' model='ir.actions.act_window'>
            <field name="name">Conexion API</field>
            <field name="res_model">mitienda.pe.partner</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>