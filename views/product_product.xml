<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="dte_view_form_product_product_inherit" model="ir.ui.view">
            <field name="name">dte_view_form_product_product_inherit</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_normal_form_view" />
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page name="mitienda_pe_product" string="MiTienda.pe"
                        invisible="product_variant_count &lt;= 1">
                        <group>
                            <group name="datos_tienda_pe_product">
                                <field name="mitienda_id" readonly="1" widget="char" />
                                <field name="mitienda_sku" />
                                <button name="verificar_sku" string="Verificar SKU"
                                    type="object" class="btn btn-primary">
                                </button>
                            </group>
                            <group>
                                <field name="mitienda_sincronizar_stock" invisible="not is_storable or not mitienda_sku or mitienda_id == 0" />
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
        <record id="dte_product_product_tree_view_inherit" model="ir.ui.view">
            <field name="name">dte_product_product_tree_view_inherit</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_product_tree_view"></field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='default_code']" position="after">
                    <field name="mitienda_sku" optional="show" />
                </xpath>
            </field>
        </record>
    </data>
</odoo>