<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="dte_view_form_mitienda_pe_sale_order" model="ir.ui.view">
            <field name="name">dte_view_form_mitienda_pe_sale_order</field>
            <field name="model">mitienda.pe.sale.order</field>
            <field name="arch" type="xml">
                <form create="0" edit="0" delete="0">
                    <sheet>
                        <group>
                            <group string="Sincronización">
                                <field name="fecha_sincronizacion" />
                                <field name="conexion_id" />
                                <field name="mensaje" />
                                <field name="error" />
                                <field name="sync_cliente_logica" />
                                <field name="sync_cliente_predefinido" />
                                <field name="sync_venta_logica" />
                                <field name="mitienda_order_code" />
                                <field name="mitienda_order_id" />
                                <field name="mitienda_order_status" />
                                <field name="mitienda_partner_id" />
                            </group>
                            <group string="venta">
                                <field name="fecha_venta" />
                                <field name="sale_order_id" />
                                <field name="partner_id" />
                                <field name="mitienda_sunat_pdf" />
                                <field name="company_id" invisible="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="dte_view_list_mitienda_pe_sale_order" model="ir.ui.view">
            <field name="name">dte_view_list_mitienda_pe_sale_order</field>
            <field name="model">mitienda.pe.sale.order</field>
            <field name="arch" type="xml">
                <list string="Bitácora" create="0" edit="0" delete="0">
                    <field name="fecha_sincronizacion" />
                    <field name="fecha_venta" />
                    <field name="mensaje" />
                    <field name="sale_order_id" widget="many2one_link" />
                    <field name="sync_venta_logica" />
                    <field name="mitienda_order_code" />
                    <field name="mitienda_order_id" />
                    <field name="mitienda_order_status" optional="hide" />
                    <field name="company_id" optional="hide"/>
                </list>
            </field>
        </record>

        <record id='action_mi_tienda_pe_sale_order' model='ir.actions.act_window'>
            <field name="name">Bitácora de sincronización de ventas</field>
            <field name="res_model">mitienda.pe.sale.order</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>