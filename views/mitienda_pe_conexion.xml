<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="dte_view_form_mitienda_conexion" model="ir.ui.view">
            <field name="name">mitienda.pe.conexion.form</field>
            <field name="model">mitienda.pe.conexion</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group string="Parámetros de conexión">
                                <field name="url" />
                                <field name="entorno" />
                                <field name="token" />
                                <field name="token_expiracion" />
                                <field name="timeout_api" />
                                <field name="activo" />
                            </group>
                            <group>
                                <group string="Sincronización de clientes">
                                    <field name="sync_cliente_logica" />
                                    <field name="sync_cliente_predefinido" />
                                </group>
                                <group string="Sincronización de ventas">
                                    <field name="sync_cliente_logica" />
                                </group>
                                <group string="Sincronización de productos">
                                    <field name="sync_cliente_logica" />
                                </group>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="dte_view_tree_mitienda_conexion" model="ir.ui.view">
            <field name="name">mitienda.pe.conexion.list</field>
            <field name="model">mitienda.pe.conexion</field>
            <field name="arch" type="xml">
                <list string="conexion api">
                    <field name="url" />
                    <field name="entorno" />
                    <field name="token_expiracion" />
                    <field name="token_header" />
                    <field name="timeout_api" />
                    <field name="activo" />
                </list>
            </field>
        </record>

        <record id='action_mi_tienda_pe_conexion' model='ir.actions.act_window'>
            <field name="name">Conexion API</field>
            <field name="res_model">mitienda.pe.conexion</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    ¿Listo para gestionar conexión a Api?
                </p>
                <p>
                    Creemos tu primer conexión
                </p>
            </field>
        </record>
    </data>
</odoo>