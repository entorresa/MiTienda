<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="dte_wizard_sincronizacion_ventas" model="ir.ui.view">
            <field name="name">dte_wizard_sincronizacion_ventas</field>
            <field name="model">wizard.mitienda.pe.ventas</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="conexion_id" />
                            <field name="fecha_inicio" />
                            <field name="fecha_fin" />
                            <field name="url" />
                            <field name="entorno" />
                        </group>
                        <footer>
                            <button name="sincronizar" string="Sincronizar"
                                type="object" class="btn btn-primary"/>
                            <button name="sincronizar" string="Cancelar"
                                type="object" class="btn btn-primary" />
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>

        <record id='action_wizard_sincronizacion_ventas' model='ir.actions.act_window'>
            <field name="name">Sincronización manual de ventas</field>
            <field name="res_model">wizard.mitienda.pe.ventas</field>
            <field name="view_mode">form</field>
        </record>
    </data>
</odoo>