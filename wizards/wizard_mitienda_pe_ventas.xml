<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="dte_wizard_sincronizacion_ventas" model="ir.ui.view">
            <field name="name">dte_wizard_sincronizacion_ventas</field>
            <field name="model">wizard.mitienda.pe.ventas</field>
            <field name="arch" type="xml">
                <form>
                    <div invisible="total_por_sincronizar &lt; 90">
                        <div class="alert alert-warning" role="alert">
                            El número de ventas para sincronizar debe ser menor o igual a 90
                        </div>
                    </div>
                    <div invisible="total_por_sincronizar == 0 or total_por_sincronizar &gt; 90">
                        <div class="alert alert-success" role="alert">
                            Preparado para iniciar la sincronización
                        </div>
                    </div>
                    <sheet>
                        <group>
                            <group>
                                <field name="fecha_inicio" readonly="total_por_sincronizar &gt; 0 and total_por_sincronizar &lt; 90" />
                                <field name="fecha_fin" readonly="total_por_sincronizar &gt; 0 and total_por_sincronizar &lt; 90" />
                                <field name="total_por_sincronizar" readonly="1" />
                            </group>
                            <group>
                                <field name="conexion_id" options="{'no_create':True, 'no_edit': True}" invisible="1" />
                                <field name="url" />
                                <field name="entorno" />
                            </group>
                        </group>
                        <footer>
                            <button name="verificar" string="Verificar"
                                type="object" class="btn btn-primary" options="{'close':False}"
                                invisible="total_por_sincronizar &gt; 0 and total_por_sincronizar &lt; 90" />
                            <button name="sincronizar" string="Sincronizar"
                                type="object" class="btn btn-success"
                                invisible="total_por_sincronizar == 0 or total_por_sincronizar &gt; 90" />
                            <button name="reiniciar_verificacion" string="Reiniciar"
                                type="object" class="btn btn-primary" options="{'close':False}"
                                invisible="total_por_sincronizar == 0 or total_por_sincronizar &gt; 90" />
                            <button string="Cancelar"
                                special="cancel" class="btn btn-danger" />
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>

        <record id='action_wizard_sincronizacion_ventas' model='ir.actions.act_window'>
            <field name="name">Sincronización manual de ventas</field>
            <field name="res_model">wizard.mitienda.pe.ventas</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>